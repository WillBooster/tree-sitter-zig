#!/usr/bin/env bash

# Parses real-world Zig files cloned into examples/ and rewrites script/known-failures.txt, the list of
# files that fail to parse. With --check, fails instead when that list would change.

set -euo pipefail

check=false
if [[ ${1-} == --check ]]; then
  check=true
fi

# Each example repository is pinned to a commit so that the list of failures changes only with the grammar.
# Moving a pin requires running this script without --check to update the list. The checkouts under
# examples/ belong to this script: local changes there are discarded so that the pinned files are parsed.
# The hosts occasionally answer with a server error, so each fetch is retried in place.
clone() {
  local dir=examples/$1
  if [[ $(git -C "$dir" rev-parse HEAD 2> /dev/null) != "$3" ]]; then
    if [[ ! -d $dir/.git ]]; then
      rm -rf "$dir"
      git init -q "$dir"
    fi
    local attempt
    for attempt in 1 2 3 4; do
      if git -C "$dir" fetch -q --depth=1 "$2" "$3"; then
        break
      fi
      if [[ $attempt == 4 ]]; then
        return 1
      fi
      sleep $((attempt * 15))
    done
    git -C "$dir" checkout -q -f --detach "$3"
  fi
  git -C "$dir" reset -q --hard
  git -C "$dir" clean -q -ffdx
}

cd "$(dirname "$0")/.."
# The CLI caches compiled parsers by language name in a directory shared by every checkout and reuses one that is newer
# than the sources, so this checkout's parser is compiled into a cache of its own.
export TREE_SITTER_LIBDIR=$PWD/.tmp/tree-sitter-lib

clone zig https://github.com/ziglang/zig cf90dfd3098bef5b3c22d5ab026173b3c357f2dd
clone tigerbeetle https://github.com/tigerbeetle/tigerbeetle 530105887eb4b4b9030f588ed543455db8f3fdb2

archive=.tmp/zig-0.16.0.tar.xz
mkdir -p .tmp
if [[ ! -f $archive ]]; then
  curl --fail --location --retry 3 https://ziglang.org/download/0.16.0/zig-0.16.0.tar.xz --output "$archive.download"
  mv "$archive.download" "$archive"
fi
node - "$archive" <<'JS'
const { createHash } = require('node:crypto');
const { readFileSync } = require('node:fs');
const assert = require('node:assert/strict');
assert.equal(
  createHash('sha256').update(readFileSync(process.argv[2])).digest('hex'),
  '43186959edc87d5c7a1be7b7d2a25efffd22ce5807c7af99067f86f99641bfdf',
  'Zig 0.16.0 source archive checksum mismatch',
);
JS
rm -rf examples/zig-current
mkdir -p examples/zig-current
tar -xJf "$archive" --strip-components=1 -C examples/zig-current zig-0.16.0/lib

files=$(mktemp)
output=$(mktemp)
failures=$(mktemp)
trap 'rm -f "$files" "$output" "$failures"' EXIT

find examples/zig examples/tigerbeetle examples/zig-current/lib -type f -name '*.zig' -print | LC_ALL=C sort > "$files"

# The CLI exits non-zero whenever a file fails, so the output decides success. `--time` makes it print
# a line for each file, including files that exceed `--timeout` (30 s), which bounds a runaway parse. The largest
# files, generated ones of a few megabytes, take about a second alone and several times as long beside the other tests.
script/tree-sitter parse --grammar-path . -q -s --time --timeout 30000000 \
  --paths "$files" > "$output" || true
if ! grep -q '^Total parses' "$output"; then
  cat "$output" >&2
  exit 1
fi
grep '^Total parses' "$output"
# With an empty known-failures.txt, a run that parses no file would pass, so every file found must have been parsed.
total=$(sed -n 's/^Total parses: \([0-9]*\);.*/\1/p' "$output")
expected=$(grep -c . "$files" || true)
if [[ $expected == 0 || $total != "$expected" ]]; then
  echo "Parsed $total of $expected example files" >&2
  exit 1
fi
# A timeout depends on the machine, so it is no expected failure.
if grep -q 'timed out' "$output"; then
  echo 'These files exceeded the parse timeout; known-failures.txt is left unchanged:' >&2
  awk -F '\t' '/timed out/{sub(/[[:space:]]+$/, "", $1); print $1}' "$output" >&2
  exit 1
fi
awk -F '\t' '/ERROR|MISSING/{sub(/[[:space:]]+$/, "", $1); print $1}' "$output" | LC_ALL=C sort > "$failures"
if grep -q '^examples/zig-current/' "$failures"; then
  echo 'Current Zig library files must parse without errors:' >&2
  grep '^examples/zig-current/' "$failures" >&2
  exit 1
fi
if [[ $check == true ]]; then
  if ! diff -u script/known-failures.txt "$failures" >&2; then
    echo 'The files failing to parse differ from script/known-failures.txt (- fixed, + broken).' >&2
    echo 'Run script/parse-examples to update the list after checking the diff.' >&2
    exit 1
  fi
else
  cp "$failures" script/known-failures.txt
fi
